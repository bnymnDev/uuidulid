<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.bnymndev</groupId>
    <artifactId>uuidulid-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>uuidulid-jpa</artifactId>
  <name>uuidulid-jpa</name>
  <description>Jakarta Persistence attribute converters for Ulid.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.bnymndev</groupId>
      <artifactId>uuidulid-core</artifactId>
    </dependency>
    <!-- 3.0 is the last Jakarta Persistence API built for Java 8. The AttributeConverter API is
         identical in 3.1/3.2, so the jar works unchanged with newer providers. -->
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <version>3.0.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.bnymndev.uuidulid.jpa</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
